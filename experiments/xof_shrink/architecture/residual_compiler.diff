+                    self.slot_of[node.uid] = s
+                    self.content[s] = node.uid
+                else:
+                    self.content[s] = MOVED
+            L.layer.d = self.d
+            self.layers.append(L.layer)
+        for layer in self.layers:
+            layer.d = self.d
+
+        placed: list[Resolved] = []
+        for i, o in enumerate(g.outputs):
+            if o[0] == "const":
+                placed.append(o)
+            elif self.out_slots is not None:
+                placed.append(("var", self.out_slots[i], 1))
+            else:
+                placed.append(("var", self.slot_of[o[1]], o[2]))
+        return placed
+
+    def _new_slot(self) -> int:
+        s = self.d
+        self.d += 1
+        self.new_slots.append(s)
+        self.content[s] = ("const", 0) if self.new_slots_fresh else JUNK
+        return s
+
+
+class _LayerBuilder:
+    """Collects the units of one layer in spin space, where b = (s + 1) / 2"""
+
+    def __init__(self, slot_of: dict[int, int]):
+        self.slot_of = slot_of
+        self.layer = Layer(d=0)
+        self.shared: dict[Any, int] = {}  # identity units per slot read, BOS unit
+
+    def _row(self, w: dict[int, float], bias: float, entries: list, row: int) -> None:
+        for s, c in w.items():
+            entries.append((row, s, c / 2))
+            bias += c / 2
+        if bias != 0:
+            entries.append((row, 0, bias))
+
+    def _add(self, gate: tuple[dict[int, float], float], value: tuple[dict[int, float], float]) -> int:
+        row = self.layer.h
+        self.layer.h += 1
+        self._row(*gate, self.layer.gates, row)
+        self._row(*value, self.layer.values, row)
+        return row
+
+    def unit(self, unit: GUnit, outs: dict[int, float]) -> None:
+        by_slot = lambda f: ({self.slot_of[j]: c for j, c in f[0].items()}, f[1])  # noqa: E731
+        row = self._add(by_slot(unit.gate), by_slot(unit.value))
+        for s, w in outs.items():
+            self.layer.outs.append((s, row, w))
+
+    def identity(self, read: int, write: int, w: float) -> None:
+        """adds w * max(0, b) to slot write, for the bit b in slot read"""
+        if read not in self.shared:
+            self.shared[read] = self._add(({read: 1.0}, 0), ({}, 1))
+        self.layer.outs.append((write, self.shared[read], w))
+
+    def linear(self, form: tuple[dict[int, float], float], write: int, w: float) -> None:
+        """adds w times the linear form of slot bits to slot write: max(0, 1) * form"""
+        row = self._add(({}, 1), form)
+        self.layer.outs.append((write, row, w))
+
+    def bos(self, write: int, w: float) -> None:
+        if "bos" not in self.shared:
+            self.shared["bos"] = self._add(({}, 1), ({}, 1))
+        self.layer.outs.append((write, self.shared["bos"], w))
+
+
+def _embed(d: int, n_in: int, stream: list[tuple]) -> t.Tensor:
+    """(d, 1 + n_in): BOS, then slot s holds stream[s - 1] = ("in", i) or ("const", c).
+    Slots past the stream hold 0"""
+    e = t.zeros(d, 1 + n_in)
+    e[:, 0] = -1
+    e[0, 0] = 1
+    for s, item in enumerate(stream, start=1):
+        if item[0] == "in":
+            e[s, 1 + item[1]] = 2
+        else:
+            e[s, 0] = 2 * item[1] - 1
+    return e
+
+
+def _readout(d: int, placed: list[Resolved]) -> t.Tensor:
+    """(1 + n, d): BOS, then each bit (1 + sign * s) / 2, or a constant"""
+    r = t.zeros(1 + len(placed), d)
+    r[0, 0] = 1
+    for i, p in enumerate(placed, start=1):
+        if p[0] == "const":
+            r[i, 0] = p[1]
+        else:
+            _, s, sign = p
+            r[i, 0] += 0.5
+            r[i, s] += 0.5 * sign
+    return r
+
+
+def compile_unrolled(fn: Callable[[list[Bit]], Any], n_in: int, **kwargs: Any) -> Program:
+    """A residual program for fn(list of n_in bits) -> bits"""
+    inputs = const("0" * n_in)
+    g = Graph(inputs, _flatten(fn(inputs)))
+    alloc = Allocator(g, {b.uid: i + 1 for i, b in enumerate(inputs)}, 1 + n_in, **kwargs)
+    placed = alloc.run()
+    n = len(alloc.layers)
+    e = _embed(alloc.d, n_in, [("in", i) for i in range(n_in)])
+    tap = Tap(n - 1, _readout(alloc.d, placed), list(range(1 + len(placed))))
+    return Program(alloc.d, e, alloc.layers, list(range(n)), [tap], 1 + len(placed))
+
+
+def compile_recurrent(
+    init: Callable[[list[Bit]], list[Bit]],
+    step: Callable[[list[Bit]], list[Bit]],
+    readout: Callable[[list[list[Bit]]], Any],
+    n_in: int,
+    n_steps: int,
+    **kwargs: Any,
+) -> Program:
+    """A residual program that applies one block of layers, compiled from step, to a
+    loop state n_steps times, so the steps share weights. init(input bits) gives the
+    first state, as input bits and constants. readout(states after each step) gives
+    the outputs, as state bits and constants; each is read out after its step, and
+    steps that read the same state bits share one readout matrix (tied)"""
+    inputs = const("0" * n_in)
+    index = {b.uid: i for i, b in enumerate(inputs)}
+    stream = []
+    for b in init(inputs):
+        if b.uid in index:
+            stream.append(("in", index[b.uid]))
+        elif not b.source.incoming:
+            stream.append(("const", int(b.activation)))
+        else:
+            raise ValueError("init must give input bits or constants")
+    n = len(stream)
+    x = const("0" * n)
+    y = step(x)
+    assert len(y) == n, "step must keep the state size"
+    slots = list(range(1, n + 1))
+    alloc = Allocator(Graph(x, y), {b.uid: s for b, s in zip(x, slots)}, 1 + n, out_slots=slots, new_slots_fresh=False, **kwargs)
+    alloc.run()
+    d, depth = alloc.d, len(alloc.layers)
+    e = _embed(d, n_in, stream)
+
+    states = [const("0" * n) for _ in range(n_steps)]
+    where = {b.uid: (k, i) for k, st in enumerate(states) for i, b in enumerate(st)}
+    outs = _flatten(readout(states))
+    placed: dict[int, list[tuple[int, Resolved]]] = defaultdict(list)  # step -> (out, bit)
+    for j, b in enumerate(outs, start=1):
+        if b.uid in where:
+            k, i = where[b.uid]
+            placed[k].append((j, ("var", slots[i], 1)))
+        elif not b.source.incoming:
+            placed[n_steps - 1].append((j, ("const", int(b.activation))))
+        else:
+            raise ValueError("readout must give state bits or constants")
+    placed[n_steps - 1]  # BOS is read after the last step
+    taps: list[Tap] = []
+    for k in sorted(placed):
+        m = _readout(d, [p for _, p in placed[k]])
+        m = next((tap.matrix for tap in taps if t.equal(tap.matrix, m)), m)  # tie
+        rows = [0 if k == n_steps - 1 else -1] + [j for j, _ in placed[k]]
+        taps.append(Tap((k + 1) * depth - 1, m, rows))
+    schedule = [i for _ in range(n_steps) for i in range(depth)]
+    return Program(d, e, alloc.layers, schedule, taps, 1 + len(outs))
+
+
+def _flatten(x: Any) -> list[Bit]:
+    if isinstance(x, Bit):
+        return [x]
+    return [b for item in x for b in _flatten(item)]
