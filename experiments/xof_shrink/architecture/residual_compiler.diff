+import itertools
+
+import pytest
+import torch as t
+
+from reifier.compile.residual import compile_recurrent, compile_unrolled
+from reifier.neurons.core import Bit, Unit, const, glu
+from reifier.neurons.operations import glu_xor, not_, and_, xor
+from reifier.tensors.residual import MLP_ResSwiGLU
+
+CHI = Unit((2, -1, 1), 0, (-1, 0.5, -0.5), 1.5)  # a ^ (~b & c)
+CHI_UPDATE = Unit((0, -1, 1), 0, (-2, 0, 0), 1)  # (1-2a) max(0, c-b), in place on a
+
+
+def outputs(mlp: MLP_ResSwiGLU, bits: tuple[int, ...]) -> list[float]:
+    y = mlp(t.tensor([[1, *bits]], dtype=t.float32))[0]
+    return (y[1:] / y[0]).tolist()
+
+
+def check_all_inputs(fn, n: int, mlp: MLP_ResSwiGLU, tol: float = 1e-3) -> None:
+    for bits in itertools.product([0, 1], repeat=n):
+        expected = [int(b.activation) for b in fn(const(bits))]
+        got = outputs(mlp, bits)
+        assert max(abs(g - e) for g, e in zip(got, expected)) < tol, (bits, got, expected)
+
+
+@pytest.mark.parametrize("n", range(1, 12))
+def test_xor_update_flat(n):
+    for bits in itertools.product([0, 1], repeat=n):
+        assert glu_xor(const(bits), inplace=True).activation == sum(bits) % 2
+        assert glu_xor(const(bits), flat=True).activation == sum(bits) % 2
+
+
+def fn_mixed(x: list[Bit]) -> list[Bit]:
+    """in place and not in place gated units, threshold gates, nots and constants"""
+    a = glu_xor(x[:4], inplace=True)  # updates x[0] in place
+    b = glu_xor([x[1], x[4], x[5]], flat=True)
+    c = xor([x[2], x[3]])  # threshold gates
+    d = glu([a, b, c], [CHI_UPDATE], inplace=0)
+    e = glu([not_(b), c, const("1")[0]], [CHI])
+    return [d, e, not_(a), and_([c, x[5]]), x[0]]
+
+
+@pytest.mark.parametrize("gated", [False, True])
+def test_unrolled(gated):
+    mlp = MLP_ResSwiGLU.from_program(compile_unrolled(fn_mixed, 6, gated=gated))
+    check_all_inputs(fn_mixed, 6, mlp)
+
+
+@pytest.mark.parametrize("gated", [False, True])
+def test_recurrent_tied(gated):
+    """a 4-bit state: a rotation with xor and chi, applied 3 times with tied weights,
+    and a register holding the first state bit of the step before"""
+
+    def step(x: list[Bit]) -> list[Bit]:
+        s, reg = x[:4], x[4]
+        new = [glu_xor([s[(i + 1) % 4], s[i], s[(i + 2) % 4]]) for i in range(4)]
+        new = [glu([new[i], new[(i + 1) % 4], new[(i + 2) % 4]], [CHI_UPDATE], inplace=0) for i in range(4)]
+        return new + [s[0]]
+
+    def init(msg: list[Bit]) -> list[Bit]:
+        return msg[:3] + const("1") + const("0")
+
+    def eager(msg: list[Bit]) -> list[Bit]:
+        states = [init(msg)]
+        for _ in range(3):
+            states.append(step(states[-1]))
+        return readout(states[1:])
+
+    def readout(states: list[list[Bit]]) -> list[Bit]:
+        return [states[0][1], states[1][2]] + states[-1]
+
+    program = compile_recurrent(init, step, readout, 3, 3, gated=gated)
+    assert len(program.layers) == 2 and program.schedule == [0, 1] * 3
+    mlp = MLP_ResSwiGLU.from_program(program)
+    n_unique = sum(p.numel() for p in mlp.parameters())
+    assert n_unique < sum(p.numel() for p in mlp.layers[0].parameters()) * 3
+    check_all_inputs(eager, 3, mlp)
