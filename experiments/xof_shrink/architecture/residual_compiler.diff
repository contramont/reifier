+import torch as t
+import torch.nn as nn
+
+from reifier.compile.residual import Program
+from .swiglu import SwiGLU
+
+
+class ResSwiGLU(SwiGLU):
+    """Pre-norm residual SwiGLU layer, as in transformers: x + SwiGLU(x)"""
+
+    def forward(self, x: t.Tensor) -> t.Tensor:
+        return x.type(self.dtype) + super().forward(x)
+
+
+class GatedResSwiGLU(SwiGLU):
+    """Residual SwiGLU layer with a fixed 0/1 gate per feature on the skip path:
+    alpha * x + SwiGLU(x), so a layer can overwrite features"""
+
+    def __init__(self, in_f: int, out_f: int, **kwargs):  # type: ignore
+        super().__init__(in_f, out_f, **kwargs)
+        self.alpha = nn.Parameter(t.ones(in_f))
+
+    def forward(self, x: t.Tensor) -> t.Tensor:
+        return self.alpha * x.type(self.dtype) + super().forward(x)
+
+
+class MLP_ResSwiGLU(nn.Module):
+    """Residual SwiGLU MLP: a linear embedding, residual SwiGLU layers applied in the
+    order of schedule (a layer may be applied several times: tied weights), and linear
+    readouts of the stream after some schedule positions (taps), which fill the rows
+    of the output given by tap_rows (-1: unused) and may be shared by several taps"""
+
+    def __init__(
+        self,
+        embed: nn.Linear,
+        layers: nn.ModuleList,
+        schedule: list[int],
+        readouts: nn.ModuleList,
+        taps: list[tuple[int, int, list[int]]],  # (schedule position, readout, rows)
+        n_out: int,
+        dtype: t.dtype = t.float32,
+    ):
+        super().__init__()  # type: ignore
+        self.dtype = dtype  # type: ignore  # ty
+        self.embed = embed
+        self.layers = layers
+        self.schedule = schedule
+        self.readouts = readouts
+        self.taps = taps
+        self.n_out = n_out
+
+    def forward(self, x: t.Tensor) -> t.Tensor:
+        x = self.embed(x.type(self.dtype))
+        out = t.zeros(*x.shape[:-1], self.n_out, dtype=self.dtype, device=x.device)
+        for pos, i in enumerate(self.schedule):
+            x = self.layers[i](x)
+            for tap_pos, r, rows in self.taps:
+                if tap_pos == pos:
+                    y = self.readouts[r](x)
+                    keep = [j for j, row in enumerate(rows) if row >= 0]
+                    out[..., [rows[j] for j in keep]] += y[..., keep]
+        return out
+
+    @classmethod
+    def from_program(cls, p: Program, dtype: t.dtype = t.float32) -> "MLP_ResSwiGLU":
+        def linear(w: t.Tensor) -> nn.Linear:
+            lin = nn.Linear(w.size(1), w.size(0), bias=False, dtype=dtype)
+            with t.no_grad():
+                lin.weight.copy_(w)
+            return lin
+
+        layers = nn.ModuleList()
+        gated = any(layer.drop for layer in p.layers)
+        for layer in p.layers:
+            wg, wv, wo = layer.matrices(dtype)
+            cls_layer = GatedResSwiGLU if gated else ResSwiGLU
+            swiglu = cls_layer(p.d, p.d, has_bias=False, dtype=dtype, hidden_f=layer.h)
+            with t.no_grad():
+                for param, w in zip([swiglu.wg, swiglu.wv, swiglu.wo], [wg, wv, wo]):
+                    param.weight.copy_(w.to_dense())
+                if gated:
+                    swiglu.alpha[layer.drop] = 0
+            layers.append(swiglu)
+        readouts = nn.ModuleList()
+        index: dict[int, int] = {}  # matrix id -> readout
+        taps = []
+        for tap in p.readout:
+            if id(tap.matrix) not in index:
+                index[id(tap.matrix)] = len(readouts)
+                readouts.append(linear(tap.matrix))
+            taps.append((tap.pos, index[id(tap.matrix)], tap.rows))
+        return cls(linear(p.embed), layers, p.schedule, readouts, taps, p.n_out, dtype)
