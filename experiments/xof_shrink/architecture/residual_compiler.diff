+"""Compiles Bit circuits to residual SwiGLU networks, x -> x + SwiGLU(x).
+
+The residual stream has d features. Feature 0 is BOS (always 1) and every other feature
+holds a bit as a spin s = 2b - 1, so all features are +-1: RMSNorm is then the identity
+(the norm cannot rescale by input, as it would with 0/1 bits) and each layer adds exact
+updates to the stream. A layer writes a new bit v into a slot that holds an old bit y
+by adding 2 (v - y):
+- copies are free, as a bit stays where it is, and so are nots (a sign flip that
+  readers fold into their weights) and constants (folded into biases),
+- a gated neuron with inplace = i (see neurons.core.glu) updates its input i in place:
+  its units already add up to v - y,
+- any other write clears y with one linear unit max(0, 1) (-y + ...), exact, which also
+  removes the error y carried; slots that hold a known constant need no clearing.
+Slots are reused once their bits are dead, like registers, so d stays close to the
+largest number of live bits. With gated=True the layers are x -> alpha x + SwiGLU(x)
+with a fixed 0/1 alpha per feature (a gated residual), and writes drop y instead.
+
+A recurrent program applies the same block of layers (tied weights) several times to
+a loop state, e.g. an XOF step, see compile_recurrent. The block writes each bit of
+the new state to the slot of the same bit of the old state, and outputs can be read
+after every step with one tied readout."""
+
+import sys
+from collections import defaultdict
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+import torch as t
+
+from reifier.neurons.core import Bit, GluNeuron, Neuron, const
+
+K = 16  # SwiGLU computes a unit max(0, g) * v as silu(K * g) * v / K, as in swiglu.py
+
+# A linear form sum_j w[j] b_j + bias over variables (by uid) that are bits b_j
+Form = tuple[dict[int, float], float]
+Resolved = tuple  # ("const", c) or ("var", uid, sign), where sign -1 means 1 - b_uid
+
+
+@dataclass
+class GUnit:
+    """A gated unit max(0, gate) * value with linear forms over variables"""
+
+    gate: Form
+    value: Form
+
+
+@dataclass
+class Node:
+    """A computed variable: its value is sum(units) + linear"""
+
+    uid: int
+    units: list[GUnit]
+    linear: Form  # e.g. the updated input of an inplace glu
+    parents: set[int]  # variables read
+    level: int = 0
+
+
+@dataclass
+class Layer:
+    """x += outs @ (silu(K * gates @ x) * (values @ x)) / K, as COO entries.
+    A gated residual layer first sets the slots in drop to 0: x = alpha * x + ..."""
+
+    d: int
+    h: int = 0
+    drop: list[int] = field(default_factory=list)  # gated: slots whose old value is dropped
+    gates: list[tuple[int, int, float]] = field(default_factory=list)  # (unit, slot, w)
+    values: list[tuple[int, int, float]] = field(default_factory=list)
+    outs: list[tuple[int, int, float]] = field(default_factory=list)  # (slot, unit, w)
+
+    def matrices(self, dtype: t.dtype = t.float32) -> tuple[t.Tensor, t.Tensor, t.Tensor]:
+        """Sparse wg, wv, wo of the SwiGLU layer, with K folded in"""
+
+        def coo(entries: list, shape: tuple[int, int], scale: float) -> t.Tensor:
+            if not entries:
+                idx = t.zeros(2, 0, dtype=t.long)
+                return t.sparse_coo_tensor(idx, t.zeros(0, dtype=dtype), shape).coalesce()
+            i, j, v = zip(*entries)
+            m = t.sparse_coo_tensor(t.tensor([i, j]), t.tensor(v, dtype=t.float64), shape)
+            m = m.coalesce()
+            keep = m.values() != 0
+            vals = (m.values()[keep] * scale).to(dtype)
+            return t.sparse_coo_tensor(m.indices()[:, keep], vals, shape).coalesce()
+
+        return (
+            coo(self.gates, (self.h, self.d), K),
+            coo(self.values, (self.h, self.d), 1),
+            coo(self.outs, (self.d, self.h), 1 / K),
+        )
+
+
+@dataclass
+class Tap:
+    """Reads outputs from the stream after schedule position pos: row i of matrix
+    gives output rows[i] (0 is BOS, -1 discards it). Taps may share a matrix"""
+
+    pos: int
+    matrix: t.Tensor  # (m, d)
+    rows: list[int]
+
+
+@dataclass
+class Program:
+    """embed -> layers[schedule[0]] -> layers[schedule[1]] -> ... , with outputs
+    [1, bits] read out linearly by taps, by default one after the last layer.
+    embed maps [1, bits] to the stream"""
+
+    d: int
+    embed: t.Tensor  # (d, 1 + n_in)
+    layers: list[Layer]  # unique layers
+    schedule: list[int]
+    readout: list[Tap]
+    n_out: int  # outputs incl. BOS
+
+
+class Graph:
+    """The circuit between given input bits and output bits, with constants folded,
+    and copies and nots resolved to (variable, sign) aliases of computed variables"""
+
+    def __init__(self, inputs: Sequence[Bit], outputs: Sequence[Bit]):
+        self.inputs = [b.uid for b in inputs]
+        assert len(set(self.inputs)) == len(self.inputs), "repeated input bits"
+        self.nodes: dict[int, Node] = {}
+        self._memo: dict[int, Resolved] = {u: ("var", u, 1) for u in self.inputs}
+        limit = sys.getrecursionlimit()
+        sys.setrecursionlimit(max(limit, 100000))
+        try:
+            self.outputs = [self.resolve(b) for b in outputs]
+        finally:
+            sys.setrecursionlimit(limit)
+        self.level = {u: 0 for u in self.inputs}
+        for u, node in self.nodes.items():  # nodes come after their parents
+            node.level = 1 + max(self.level[p] for p in node.parents)
+            self.level[u] = node.level
+        self.depth = max([n.level for n in self.nodes.values()], default=0)
+
+    def resolve(self, b: Bit) -> Resolved:
+        if b.uid in self._memo:
+            return self._memo[b.uid]
+        src = b.source
+        parents = [self.resolve(p) for p in src.incoming]
+        variables = {p[1] for p in parents if p[0] == "var"}
+        if not variables:
+            r: Resolved = ("const", int(b.activation))
+        elif len(variables) == 1:  # a function of one bit: a constant, copy or not
+            (u,) = variables
+            f0, f1 = (_evaluate(src, [_value(p, x) for p in parents]) for x in (0, 1))
+            r = ("const", f0) if f0 == f1 else ("var", u, 1 if f1 else -1)
+        else:
+            self.nodes[b.uid] = _node(b.uid, src, parents)
+            r = ("var", b.uid, 1)
+        self._memo[b.uid] = r
+        return r
+
+
+def _value(p: Resolved, x: int) -> int:
+    if p[0] == "const":
+        return p[1]
+    return x if p[2] == 1 else 1 - x
+
+
+def _evaluate(src: Neuron | GluNeuron, x: list[int]) -> int:
+    if isinstance(src, GluNeuron):
+        total = 0 if src.inplace is None else x[src.inplace]
+        for u in src.units:
+            g = sum(a * w for a, w in zip(x, u.weights)) + u.bias
+            v = sum(a * w for a, w in zip(x, u.value_weights)) + u.value_bias
+            total += max(0, g) * v
+        return int(total)
+    return int(sum(a * w for a, w in zip(x, src.weights)) + src.bias >= 0)
+
+
+def _form(parents: list[Resolved], weights: Sequence[float], bias: float) -> Form:
+    """sum_i w_i x_i + bias over resolved parents, as a form over variables"""
+    w: dict[int, float] = defaultdict(float)
+    for p, wi in zip(parents, weights):
+        if wi == 0:
+            continue
+        if p[0] == "const":
+            bias += wi * p[1]
+        elif p[2] == 1:
+            w[p[1]] += wi
+        else:  # wi (1 - b)
+            bias += wi
+            w[p[1]] -= wi
+    return {j: v for j, v in w.items() if v != 0}, bias
+
+
+def _node(uid: int, src: Neuron | GluNeuron, parents: list[Resolved]) -> Node:
+    if isinstance(src, GluNeuron):
+        units = [
+            GUnit(_form(parents, u.weights, u.bias), _form(parents, u.value_weights, u.value_bias))
+            for u in src.units
+        ]
+        lin: dict[int, float] = defaultdict(float)
+        bias = 0.0
+        if src.inplace is not None:
+            e = [int(j == src.inplace) for j in range(len(parents))]
+            w, bias = _form(parents, e, 0)
+            for j, c in w.items():
+                lin[j] += c
+        for u in [u for u in units if not u.gate[0]]:  # constant gate c: c * value
+            c = u.gate[1]
+            if c > 0:
+                for j, v in u.value[0].items():
+                    lin[j] += c * v
+                bias += c * u.value[1]
+        units = [u for u in units if u.gate[0]]
+        linear: Form = ({j: c for j, c in lin.items() if c != 0}, bias)
+    else:  # threshold gate z >= 0 as a step of two units, as SwiGLU.from_matrix does:
+        # 4max(0, z+5/8) - 4max(0, z+3/8), with gates scaled by 4 as the norm does not
+        # sharpen them here: max(0, 4z+5/2) - max(0, 4z+3/2), within e^-24 at integer z
+        z, zbias = _form(parents, src.weights, src.bias)
+        z4 = {j: 4 * c for j, c in z.items()}
+        units = [GUnit((z4, 4 * zbias + 2.5), ({}, 1)), GUnit((z4, 4 * zbias + 1.5), ({}, -1))]
+        linear = ({}, 0)
+    variables = {p[1] for p in parents if p[0] == "var"}
+    return Node(uid, units, linear, variables)
+
+
+JUNK = ("junk",)  # a slot holding an unknown bit, e.g. scratch of an earlier step
+MOVED = ("moved",)  # a slot holding a loop state bit moved there
+
+
+class Allocator:
+    """Assigns stream slots to the variables of a graph, level by level, and emits the
+    layers that compute them. A write of node v into a slot holding y adds
+    2 (units(v) + linear(v) - y). Its linear rest is one linear unit, max(0, 1) times
+    the rest (clear="linear", exact, so it also removes the error of y), or shared
+    units max(0, b) per slot read (clear="relu"); a constant rest is one BOS unit
+    per layer, and there is no rest for an update in place.
+    Slot choice: a forced slot (recurrent outputs), the slot a forced update in place
+    needs its target in (hint), the slot of its target for an update in place, a
+    slot holding a known bit, a dead slot, or a new slot"""
+
+    def __init__(
+        self,
+        graph: Graph,
+        slot_of: dict[int, int],  # input uid -> slot
+        d: int,
+        out_slots: list[int] | None = None,  # recurrent: the slot of each output
+        new_slots_fresh: bool = True,  # new slots hold 0, else junk
+        prefer_new: bool = False,  # take a new slot rather than clear a dead one
+        clear: str = "linear",  # or "relu"
+        gated: bool = False,  # gated residual: a write that is not in place drops y
+    ):
+        assert clear in ("linear", "relu")
+        self.clear = clear
+        self.gated = gated
+        self.g = graph
+        self.slot_of = dict(slot_of)
+        self.d = d
+        self.content: dict[int, Any] = {s: u for u, s in slot_of.items()}
+        self.new_slots_fresh = new_slots_fresh
+        self.prefer_new = prefer_new
+        self.new_slots: list[int] = []
+        self.out_slots = out_slots
+        self.layers: list[Layer] = []
